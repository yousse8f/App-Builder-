// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ClientStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum LicenseType {
  PLUGIN
  BUILDER
}

enum LicenseStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  EXPIRED
}

enum ActivationStatus {
  ACTIVE
  INACTIVE
}

enum LicenseLogAction {
  CREATE
  ACTIVATE
  VALIDATE
  DEACTIVATE
  SUSPEND
  REACTIVATE
  BLOCK
  UNBLOCK
  EXPIRE
  REVOKE
}

enum PluginStatus {
  ACTIVE
  INACTIVE
  DISABLED
}



enum Platform {
  IOS
  ANDROID
  BOTH
}

enum DeviceType {
  IPHONE
  IPAD
  ANDROID_PHONE
  ANDROID_TABLET
}

enum BuildStatus {
  PENDING
  PREPARING
  BUILDING
  COMPLETED
  FAILED
}

enum BuildPlatform {
  ANDROID
  IOS
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  passwordHash     String
  refreshTokenHash String?
  role             UserRole   @default(CLIENT)
  status           UserStatus @default(ACTIVE)
  phone            String?
  language         String     @default("en")
  avatar           String?

  client           Client?
  passwordResetTokens PasswordResetToken[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Client {
  id          String       @id @default(cuid())
  companyName String
  status      ClientStatus @default(ACTIVE)

  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects    Project[]
  licenses    License[]
  plugins     Plugin[]
  clientTemplates ClientTemplate[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  thumbnail   String?
  thumbnailUrl String?

  // Metadata
  platform    Platform @default(BOTH)
  deviceType  DeviceType?
  orientation String?
  width       Int?
  height      Int?

  // Screenshots integration
  appshotProjectName String?   // Links to Screenshots project
  appshotTemplateId String?    // Selected template ID
  projectType        String  @default("standard") // "standard" or "screenshots"

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  screens     ProjectScreen[]
  assets      ProjectAsset[]
  builds      Build[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model License {
  id               String        @id @default(cuid())
  key              String        @unique
  type             LicenseType
  status           LicenseStatus @default(ACTIVE)
  domain           String?
  activationLimit  Int           @default(1)
  activationCount  Int           @default(0)
  expiresAt        DateTime?

  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  activations      LicenseActivation[]
  logs             LicenseLog[]
  plugins          Plugin[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model LicenseActivation {
  id               String           @id @default(cuid())
  licenseId        String
  license          License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  
  domain           String
  ipAddress        String?
  userAgent        String?
  activatedAt      DateTime         @default(now())
  lastValidatedAt  DateTime?
  status           ActivationStatus @default(ACTIVE)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([licenseId, domain])
}

model LicenseLog {
  id           String         @id @default(cuid())
  licenseId    String
  license      License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
   
  action       LicenseLogAction
  domain       String?
  ipAddress    String?
  result       String
  metadata     String?
   
  createdAt    DateTime       @default(now())
}

model Plugin {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  version     String       @default("1.0.0")
  status      PluginStatus @default(INACTIVE)

  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  licenseId   String?
  license     License?     @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  fileUrl     String?
  fileKey     String?
  iconUrl     String?
  config      Json         @default("{}")

  logs        PluginLog[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PluginLog {
  id        String   @id @default(cuid())
  pluginId  String
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  action    String
  result    String
  details   String?

  createdAt DateTime @default(now())
}



// Extended Project functionality
model ProjectScreen {
  id          String   @id @default(cuid())
  name        String
  order       Int

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  config      Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectAsset {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  deviceId    String?
  metadata    Json?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// Build system
model Build {
  id          String        @id @default(cuid())
  name        String
  version     String?
  status      BuildStatus   @default(PENDING)
  platform    BuildPlatform
  
  // Build outputs
  apkUrl      String?
  ipaUrl      String?
  logs        String?
  
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Client-Template relation for AppShot template access control
model ClientTemplate {
  id          String   @id @default(cuid())
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  templateId  String   // The template ID from AppShot (e.g., 'bold-gradient', 'clean-light')
  
  // Optional: custom name/description for this client
  customName  String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, templateId])
}
