# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/app_builder?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# HMAC Authentication for License API
HMAC_API_KEY="your-api-key-for-hmac-auth"
HMAC_API_SECRET="your-hmac-secret-key-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV="development"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# Optional: For production deployments
# DATABASE_URL="postgresql://user:password@production-host:5432/app_builder?schema=public"
# FRONTEND_URL="https://your-frontend-domain.com"
# CLIENT_URL="https://your-client-domain.com"
